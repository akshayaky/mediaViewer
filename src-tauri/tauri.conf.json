{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyview",
  "version": "1.0.0",
  "identifier": "com.akymaster.veyview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veyview",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-set-fullscreen",
            "core:window:allow-is-fullscreen",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "opener:default",
            "fs:default",
            "fs:allow-read-file",
            "fs:allow-open",
            "fs:allow-read",
            "sql:default",
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "sql:allow-close",
            "android-fs:default",
            {
              "identifier": "http:default",
              "allow": [
                { "url": "https://image.tmdb.org/**" },
                { "url": "https://images.igdb.com/**" },
                { "url": "https://api.notion.com/*" },
                { "url": "https://api.igdb.com/v4/**" },
                { "url": "https://id.twitch.tv/oauth2/token" },
                { "url": "https://api.introdb.app/**" }
              ]
            },
            {
              "identifier": "opener:allow-open-path",
              "allow": [{ "path": "**" }]
            }
          ]
        }
      ]
    }
  },
  "plugins": {
    "android-fs": {
      "contentProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "lib/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
