{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.jules.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "opener:default",
            {
              "identifier": "http:default",
              "allow": [
                { "url": "https://image.tmdb.org/**" },
                { "url": "https://images.igdb.com/**" },
                { "url": "https://api.notion.com/*" },
                { "url": "https://api.igdb.com/v4/**"},
                { "url": "https://id.twitch.tv/oauth2/token"}
              ]
            },
            {
              "identifier": "opener:allow-open-path",
              "allow": [{ "path": "**" }]
            },
            "fs:default",
            {
              "identifier": "fs:allow-read-file",
              "allow": [
                {
                  "path": "C:\\Users\\akyma\\Videos\\**"
                }
              ]
            },
            "sql:default",
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "sql:allow-close",
            "android-fs:default",
            "fs:default",
            "fs:allow-read-file"
            
          ]
        }
      ]
    }
  },
  "plugins": {
    "android-fs": {
      "contentProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
